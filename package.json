{
  "name": "buildview",
  "version": "0.1.0",
  "description": "Autonomous codebase architecture visualizer, AST invariant linter, and FigBridge design mapper",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "buildview": "bin/buildview.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./scanner": {
      "types": "./dist/server/repo-scanner-service.d.ts",
      "import": "./dist/server/repo-scanner-service.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build",
    "buildview": "tsx src/cli/index.ts",
    "scan": "tsx src/cli/index.ts scan",
    "check": "tsx src/cli/index.ts check",
    "mcp": "tsx src/server/mcp-standalone.ts",
    "example:simulate": "tsx src/examples/simulate-cli.ts",
    "scan:sample": "tsx src/examples/scan-sample.ts"
  },
  "keywords": [
    "architecture",
    "visualizer",
    "dag",
    "dagre",
    "ast",
    "dead-code",
    "waste-detection",
    "pruning",
    "dependency-graph",
    "dependency-cruiser",
    "figma",
    "figbridge",
    "mcp",
    "model-context-protocol",
    "linter",
    "invariants",
    "devtools"
  ],
  "author": "Rudra Pratap Singh",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudraptpsingh/BuildView.git"
  },
  "bugs": {
    "url": "https://github.com/rudraptpsingh/BuildView/issues"
  },
  "homepage": "https://github.com/rudraptpsingh/BuildView#readme",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dependency-cruiser": "^18.7.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jscpd": "^5.4.2",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
